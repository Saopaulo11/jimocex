# JimoCex — environment configuration.
#
#   cp .env.example .env
#
# .env is gitignored. It holds SUPABASE_SERVICE_ROLE_KEY, which bypasses Row
# Level Security and therefore bypasses every access rule in this repository.

# --- Supabase ----------------------------------------------------------------

# The Supabase project for this environment. Both of these are public by design: they are shipped to
# the browser, and the database's RLS policies are what constrain them.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-TEST-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix this with NEXT_PUBLIC_, never import it into a
# client component, never log it. It can read and write every row of every
# user's data, and the database provides no safety net for it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application -------------------------------------------------------------

# Absolute base URL, used to build email confirmation and password reset links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Providers ---------------------------------------------------------------
#
# Every provider defaults to an adapter that honestly refuses. Leave these unset
# until a real integration exists: a deployment with no feed shows "unavailable"
# rather than invented numbers.

# Market data source. Values: "binance" | "prototype" | "unavailable".
#   binance      public, read-only market data (no key, no account, display only;
#                BTC-USDT, ETH-USDT and SOL-USDT). If it cannot be reached, prices
#                show as unavailable — nothing is substituted.
#   prototype    deterministic DEMO prices, labelled "Demo data" — an explicit
#                choice for local/demo use, never a market feed.
#   unavailable  honest no-price everywhere.
# When UNSET, the brand config decides: product.demoMarketData (src/config/brand.ts)
# true selects "prototype"; false (the default) selects "binance". An unknown value
# selects "unavailable". Market data never feeds the order engine, fees, reserves,
# the ledger or settlement; execution is JIMOCEX_EXECUTION_PROVIDER, below.
# JIMOCEX_MARKET_DATA_PROVIDER=

# Execution / liquidity venue. Default: "unavailable" (no venue connected; a
# reserved LIMIT order rests OPEN and never fills). A real adapter's OWN
# credentials are its own SERVER-ONLY variables — never NEXT_PUBLIC_*, never in
# src/config/brand.ts. See docs/execution-provider.md.
# JIMOCEX_EXECUTION_PROVIDER=

# --- Demo mode ---------------------------------------------------------------
#
# Must be false or unset in production (spec §61).
# NEXT_PUBLIC_JIMOCEX_DEMO_MODE=false

# Demo account funding — DEVELOPMENT / PREVIEW ONLY, read by the operator CLI
# scripts/fund-demo-account.ts and by nothing in the application. It refuses
# unless NEXT_PUBLIC_JIMOCEX_DEMO_MODE=true, nothing says production, and the
# Supabase URL is a local stack or the supabase.co project named here (never the
# production project). Put these in a separate env file for that one run, not in
# a deployment. Procedure: docs/preview-environment.md, step 7.
# JIMOCEX_DEMO_FUNDING_PROJECT_REF=
# JIMOCEX_DEMO_ACCOUNT_EMAIL=
